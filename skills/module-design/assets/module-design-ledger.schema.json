{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "module-design/ledger@1",
  "title": "Module design finding ledger",
  "type": "object",
  "required": ["version", "skill", "repo", "updated", "entries"],
  "properties": {
    "version": { "const": 1 },
    "skill": { "const": "module-design" },
    "repo": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "type",
          "title",
          "severity",
          "status",
          "module",
          "first_seen",
          "last_seen",
          "commit"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "const": "design" },
          "type": {
            "enum": [
              "leakage-interface",
              "leakage-back-door",
              "shallow",
              "over-config",
              "temporal-decomposition",
              "improvement"
            ]
          },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["Critical", "Major", "Minor"] },
          "status": { "enum": ["open", "resolved", "regressed", "stale", "wontfix"] },
          "module": { "type": "string" },
          "detail": { "type": "string" },
          "location": {
            "type": ["object", "null"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "symbol": { "type": ["string", "null"] }
            }
          },
          "first_seen": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "last_seen": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "fixed_at": { "type": ["string", "null"] },
          "fixed_commit": { "type": ["string", "null"] },
          "commit": { "type": "string" },
          "evidence": { "type": ["object", "null"] },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
