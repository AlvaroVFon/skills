{
  "version": 1,
  "skill": "bug-scan",
  "repo": "{owner/name}",
  "updated": "{YYYY-MM-DD}",
  "entries": [
    {
      "id": "{category-slug}-{hash}",
      "kind": "bug",
      "title": "{short title}",
      "severity": "{Critical | Major | Minor}",
      "category": "{logic | concurrency | errors-resources | data-integrity}",
      "verdict": "{Confirmed | Unconfirmed}",
      "status": "{open | fixed | regressed | stale | wontfix}",
      "location": { "file": "{path}", "line": 0, "symbol": "{symbol | null}" },
      "first_seen": "{YYYY-MM-DD}",
      "last_seen": "{YYYY-MM-DD}",
      "fixed_at": null,
      "fixed_commit": null,
      "commit": "{short sha}",
      "evidence": null,
      "notes": []
    }
  ]
}
