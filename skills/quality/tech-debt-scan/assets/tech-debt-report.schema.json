{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tech-debt-scan/report@1",
  "title": "Tech debt scan report",
  "type": "object",
  "required": [
    "schema",
    "date",
    "scan_type",
    "requested_by",
    "commit",
    "baseline",
    "coverage",
    "counters",
    "findings",
    "delta"
  ],
  "properties": {
    "schema": {
      "const": "tech-debt-scan/report@1"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scan_type": {
      "enum": ["global", "targeted"]
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "string",
      "description": "Previous report path or 'none'"
    },
    "target": {
      "type": "string",
      "description": "Optional repo or module display name"
    },
    "scope": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Required for targeted scans, null for global"
    },
    "coverage": {
      "type": "object",
      "required": ["reviewed", "not_reviewed"],
      "properties": {
        "reviewed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "depth"],
            "properties": {
              "target": {
                "type": "string"
              },
              "depth": {
                "enum": ["deep", "shallow"]
              }
            }
          }
        },
        "not_reviewed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "reason"],
            "properties": {
              "target": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "counters": {
      "type": "object",
      "required": ["critical", "major", "minor", "discarded"],
      "properties": {
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "discarded": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "category",
          "symptom",
          "cause",
          "status",
          "location",
          "description",
          "impact",
          "scores",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable finding id; computed by reconcile.py when omitted"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": ["Critical", "Major", "Minor"],
            "description": "Derived by reconcile.py from priority; never authored"
          },
          "category": {
            "enum": ["code", "tests", "architecture", "docs", "infra"]
          },
          "status": {
            "enum": ["new", "persists", "fixed", "regressed"],
            "description": "Observed lifecycle status in this scan"
          },
          "location": {
            "type": "object",
            "required": ["file", "line"],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 0
              },
              "symbol": {
                "type": ["string", "null"]
              }
            }
          },
          "evidence": {
            "type": "object",
            "required": ["method", "result"],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string"
          },
          "priority": {
            "type": "number",
            "minimum": 0,
            "description": "impact*frequency*reach/effort, rounded to 1 decimal; derived by reconcile.py"
          },
          "symptom": {
            "enum": ["change-amplification", "cognitive-load", "unknown-unknowns"]
          },
          "cause": {
            "enum": ["dependency", "obscurity"]
          },
          "scores": {
            "type": "object",
            "required": ["impact", "frequency", "reach", "effort"],
            "properties": {
              "impact": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "frequency": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "reach": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "effort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        }
      }
    },
    "delta": {
      "type": "object",
      "required": ["persists", "fixed", "new", "not_rechecked"],
      "properties": {
        "persists": {
          "type": "integer",
          "minimum": 0
        },
        "fixed": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "regressed": {
          "type": "integer",
          "minimum": 0
        },
        "not_rechecked": {
          "type": "integer",
          "minimum": 0
        },
        "fixed_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "location", "title"],
            "properties": {
              "id": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        },
        "not_rechecked_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "location", "reason"],
            "properties": {
              "id": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
