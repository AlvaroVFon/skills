{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "api-security-scan/report@1",
  "title": "API security scan report",
  "type": "object",
  "required": [
    "schema",
    "date",
    "scan_type",
    "requested_by",
    "commit",
    "baseline",
    "coverage",
    "counters",
    "findings",
    "delta"
  ],
  "properties": {
    "schema": {
      "const": "api-security-scan/report@1"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scan_type": {
      "enum": ["global", "targeted"]
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "string",
      "description": "Previous report path or 'none'"
    },
    "target": {
      "type": "string",
      "description": "Optional repo or module display name"
    },
    "scope": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Required for targeted scans, null for global"
    },
    "coverage": {
      "type": "object",
      "required": ["reviewed", "not_reviewed"],
      "properties": {
        "reviewed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "depth"],
            "properties": {
              "target": {
                "type": "string"
              },
              "depth": {
                "enum": ["deep", "shallow"]
              }
            }
          }
        },
        "not_reviewed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "reason"],
            "properties": {
              "target": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "counters": {
      "type": "object",
      "required": ["confirmed", "unconfirmed", "discarded"],
      "properties": {
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "unconfirmed": {
          "type": "integer",
          "minimum": 0
        },
        "discarded": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "severity", "category", "verdict", "status", "location", "scenario"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable finding id; computed by reconcile.py when omitted"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": ["Critical", "High", "Medium", "Low"]
          },
          "category": {
            "enum": [
              "authn",
              "authz",
              "injection",
              "info-leak",
              "config-exposure",
              "resource-business",
              "error-handling"
            ]
          },
          "owasp_api": {
            "type": ["string", "null"],
            "pattern": "^API([1-9]|10):2023$",
            "description": "OWASP API Security Top 10 (2023) entry, or null"
          },
          "owasp_top10": {
            "type": ["string", "null"],
            "pattern": "^A(0[1-9]|10):2025$",
            "description": "OWASP Top 10:2025 entry, or null"
          },
          "cwe": {
            "type": ["string", "null"],
            "pattern": "^CWE-\\d+$"
          },
          "endpoint": {
            "type": ["object", "null"],
            "required": ["method", "path"],
            "properties": {
              "method": {
                "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "ANY"]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Affected route, or null when not tied to one (e.g. logs, secrets)"
          },
          "remediation_hint": {
            "type": ["string", "null"],
            "description": "One line; never a patch"
          },
          "verdict": {
            "enum": ["Confirmed", "Unconfirmed"]
          },
          "status": {
            "enum": ["new", "persists", "fixed", "regressed"],
            "description": "Observed lifecycle status in this scan"
          },
          "location": {
            "type": "object",
            "required": ["file", "line"],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 0
              },
              "symbol": {
                "type": ["string", "null"]
              }
            }
          },
          "scenario": {
            "type": "string",
            "description": "attacker/request -> impact"
          },
          "evidence": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["test", "manual"]
              },
              "lang": {
                "type": ["string", "null"]
              },
              "code": {
                "type": ["string", "null"],
                "description": "Exploit test code; secrets redacted"
              },
              "output": {
                "type": ["string", "null"],
                "description": "Raw output; secrets redacted"
              }
            }
          },
          "manual_steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "delta": {
      "type": "object",
      "required": ["persists", "fixed", "new", "not_rechecked"],
      "properties": {
        "persists": {
          "type": "integer",
          "minimum": 0
        },
        "fixed": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "regressed": {
          "type": "integer",
          "minimum": 0
        },
        "not_rechecked": {
          "type": "integer",
          "minimum": 0
        },
        "fixed_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "location", "title"],
            "properties": {
              "id": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        },
        "not_rechecked_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "location", "reason"],
            "properties": {
              "id": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
