{
  "schema": "api-security-scan/report@1",
  "date": "{YYYY-MM-DD}",
  "scan_type": "{global | targeted}",
  "requested_by": "{git config user.name}",
  "commit": "{git rev-parse --short HEAD}",
  "baseline": "{previous report path | none}",
  "target": "{api or service name}",
  "scope": ["{route prefix, path or module}"],
  "coverage": {
    "reviewed": [
      {
        "target": "{module/path}",
        "depth": "{deep | shallow}"
      }
    ],
    "not_reviewed": [
      {
        "target": "{module/path}",
        "reason": "{why}"
      }
    ]
  },
  "counters": {
    "confirmed": 0,
    "unconfirmed": 0,
    "discarded": 0
  },
  "findings": [
    {
      "title": "{short title}",
      "severity": "{Critical | High | Medium | Low}",
      "category": "{authn | authz | injection | info-leak | config-exposure | resource-business | error-handling}",
      "owasp_api": "{API1:2023..API10:2023 | null}",
      "owasp_top10": "{A01:2025..A10:2025 | null}",
      "cwe": "{CWE-n | null}",
      "endpoint": {
        "method": "{GET | POST | PUT | PATCH | DELETE | ANY}",
        "path": "{/route/:param}"
      },
      "verdict": "{Confirmed | Unconfirmed}",
      "status": "{new | persists | fixed | regressed}",
      "location": {
        "file": "{path}",
        "line": 0,
        "symbol": "{symbol | null}"
      },
      "scenario": "{attacker/request -> impact}",
      "evidence": {
        "type": "{test | manual}",
        "lang": "{lang | null}",
        "code": "{exploit test code, secrets redacted | null}",
        "output": "{response proving the exploit | not runnable: reason | null}"
      },
      "manual_steps": ["{step}"],
      "remediation_hint": "{one line, never a patch}"
    }
  ],
  "delta": {
    "persists": 0,
    "fixed": 0,
    "new": 0,
    "regressed": 0,
    "not_rechecked": 0,
    "fixed_items": [
      {
        "id": "{id}",
        "location": "{file}:{line}",
        "title": "{title}"
      }
    ],
    "not_rechecked_items": [
      {
        "id": "{id}",
        "location": "{file}:{line}",
        "reason": "{why}"
      }
    ]
  }
}
