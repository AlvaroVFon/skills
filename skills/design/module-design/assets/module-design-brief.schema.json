{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "module-design/brief@1",
  "title": "Module design brief",
  "type": "object",
  "required": [
    "schema",
    "date",
    "requested_by",
    "commit",
    "baseline",
    "module",
    "responsibility",
    "public_interface",
    "depth_verdict",
    "findings",
    "delta"
  ],
  "properties": {
    "schema": { "const": "module-design/brief@1" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "requested_by": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "baseline": { "type": "string" },
    "module": { "type": "string", "minLength": 1 },
    "language": { "type": "string" },
    "responsibility": { "type": "string", "minLength": 1 },
    "public_interface": {
      "type": "object",
      "required": ["language", "code"],
      "properties": {
        "language": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "hidden_knowledge": { "type": "array", "items": { "type": "string" } },
    "complexity_absorbed": { "type": "array", "items": { "type": "string" } },
    "failure_contract": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["failure", "caller_sees", "caller_action"],
        "properties": {
          "failure": { "type": "string" },
          "caller_sees": { "type": "string" },
          "caller_action": { "type": "string" }
        }
      }
    },
    "split_merge": {
      "type": "object",
      "required": ["decision", "rationale"],
      "properties": {
        "decision": { "enum": ["split", "merge", "keep"] },
        "rationale": { "type": "string" }
      }
    },
    "depth_verdict": {
      "type": "object",
      "required": ["macro", "micro"],
      "properties": {
        "macro": { "enum": ["deep", "acceptable", "shallow"] },
        "macro_evidence": { "type": "string" },
        "micro": { "enum": ["deep", "acceptable", "shallow"] },
        "micro_evidence": { "type": "string" }
      }
    },
    "caller_snippet": {
      "type": "object",
      "properties": {
        "language": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "before_after_interface": { "type": ["string", "null"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "title", "severity", "status", "module", "detail"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "enum": [
              "leakage-interface",
              "leakage-back-door",
              "shallow",
              "over-config",
              "temporal-decomposition",
              "improvement"
            ]
          },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["Critical", "Major", "Minor"] },
          "status": { "enum": ["new", "persists", "resolved", "regressed"] },
          "module": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "location": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "symbol": { "type": ["string", "null"] }
            }
          },
          "evidence": { "type": ["object", "null"] }
        }
      }
    },
    "delta": {
      "type": "object",
      "required": ["persists", "resolved", "new", "not_rechecked"],
      "properties": {
        "persists": { "type": "integer", "minimum": 0 },
        "resolved": { "type": "integer", "minimum": 0 },
        "new": { "type": "integer", "minimum": 0 },
        "regressed": { "type": "integer", "minimum": 0 },
        "not_rechecked": { "type": "integer", "minimum": 0 },
        "resolved_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "location", "title"],
            "properties": {
              "id": { "type": "string" },
              "location": { "type": "string" },
              "title": { "type": "string" }
            }
          }
        },
        "not_rechecked_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "location", "reason"],
            "properties": {
              "id": { "type": "string" },
              "location": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
