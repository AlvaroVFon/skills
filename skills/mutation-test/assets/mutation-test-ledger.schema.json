{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mutation-test/ledger@1",
  "title": "Mutation test survivor ledger",
  "type": "object",
  "required": ["version", "skill", "repo", "updated", "entries"],
  "properties": {
    "version": { "const": 1 },
    "skill": { "const": "mutation-test" },
    "repo": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "severity",
          "operator",
          "status",
          "location",
          "first_seen",
          "last_seen",
          "commit"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "const": "mutant" },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["Critical", "Major", "Minor"] },
          "operator": {
            "enum": [
              "boundary",
              "conditional",
              "logical",
              "arithmetic",
              "statement-removal",
              "return",
              "literal",
              "branch",
              "argument"
            ]
          },
          "status": {
            "enum": [
              "survived",
              "killed",
              "regressed",
              "stale",
              "wontfix",
              "equivalent",
              "invalid",
              "not-run",
              "inconclusive"
            ]
          },
          "location": {
            "type": "object",
            "required": ["file", "line"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "symbol": { "type": ["string", "null"] }
            }
          },
          "gap": { "type": "string" },
          "mutant_diff": { "type": ["string", "null"] },
          "tests": { "type": "array", "items": { "type": "string" } },
          "first_seen": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "last_seen": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "fixed_at": { "type": ["string", "null"] },
          "fixed_commit": { "type": ["string", "null"] },
          "commit": { "type": "string" },
          "evidence": { "type": ["object", "null"] },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
