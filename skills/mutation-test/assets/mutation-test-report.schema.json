{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mutation-test/report@1",
  "title": "Mutation test report",
  "type": "object",
  "required": [
    "schema",
    "date",
    "scan_type",
    "requested_by",
    "commit",
    "baseline",
    "coverage",
    "summary",
    "by_module",
    "findings",
    "delta"
  ],
  "properties": {
    "schema": { "const": "mutation-test/report@1" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "scan_type": { "enum": ["global", "targeted"] },
    "requested_by": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "baseline": { "type": "string" },
    "target": { "type": "string" },
    "scope": { "type": ["array", "null"], "items": { "type": "string" } },
    "cap": { "type": "string" },
    "coverage": {
      "type": "object",
      "required": ["reviewed", "not_reviewed", "not_covered"],
      "properties": {
        "reviewed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "mutants"],
            "properties": { "target": { "type": "string" }, "mutants": { "type": "integer" } }
          }
        },
        "not_reviewed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "reason"],
            "properties": { "target": { "type": "string" }, "reason": { "type": "string" } }
          }
        },
        "not_covered": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "reason"],
            "properties": { "target": { "type": "string" }, "reason": { "type": "string" } }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "score",
        "killed",
        "survived",
        "generated",
        "invalid",
        "equivalent",
        "not_run",
        "inconclusive"
      ],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "killed": { "type": "integer", "minimum": 0 },
        "survived": { "type": "integer", "minimum": 0 },
        "generated": { "type": "integer", "minimum": 0 },
        "invalid": { "type": "integer", "minimum": 0 },
        "equivalent": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 }
      }
    },
    "by_module": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "mutants", "killed", "survived", "score"],
        "properties": {
          "module": { "type": "string" },
          "mutants": { "type": "integer" },
          "killed": { "type": "integer" },
          "survived": { "type": "integer" },
          "score": { "type": "integer" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "severity", "operator", "status", "location", "gap"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["Critical", "Major", "Minor"] },
          "operator": {
            "enum": [
              "boundary",
              "conditional",
              "logical",
              "arithmetic",
              "statement-removal",
              "return",
              "literal",
              "branch",
              "argument"
            ]
          },
          "status": { "enum": ["new", "persists", "killed", "regressed"] },
          "location": {
            "type": "object",
            "required": ["file", "line"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "line": { "type": "integer", "minimum": 0 },
              "symbol": { "type": ["string", "null"] }
            }
          },
          "gap": { "type": "string" },
          "mutant_diff": { "type": ["string", "null"] },
          "tests": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["test", "manual"] },
              "lang": { "type": ["string", "null"] },
              "code": { "type": ["string", "null"] },
              "output": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "delta": {
      "type": "object",
      "required": ["persists", "killed", "new", "not_rechecked"],
      "properties": {
        "persists": { "type": "integer", "minimum": 0 },
        "killed": { "type": "integer", "minimum": 0 },
        "new": { "type": "integer", "minimum": 0 },
        "regressed": { "type": "integer", "minimum": 0 },
        "not_rechecked": { "type": "integer", "minimum": 0 },
        "killed_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "location", "title"],
            "properties": {
              "id": { "type": "string" },
              "location": { "type": "string" },
              "title": { "type": "string" }
            }
          }
        },
        "not_rechecked_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "location", "reason"],
            "properties": {
              "id": { "type": "string" },
              "location": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
